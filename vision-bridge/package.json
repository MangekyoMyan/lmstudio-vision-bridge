{
  "name": "lmstudio-vision-bridge-generator",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Vision Bridge: LM Studio Generator plugin plus standalone OpenAI-compatible proxy for Open WebUI and other clients.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "lms dev",
    "gui": "node gui/server.mjs",
    "gui:dev": "node gui/server.mjs --with-lms-dev",
    "proxy": "node proxy/server.mjs"
  },
  "dependencies": {
    "@lmstudio/sdk": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
